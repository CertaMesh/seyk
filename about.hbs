<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seyk third-party licences</title>
  <style>
    body { font-family: sans-serif; max-width: 70rem; margin: 2rem auto; padding: 0 1rem; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <h1>Seyk third-party licences</h1>
  <p>Generated from the locked workspace, including all features and platforms.
     This covers a superset of each release build. See THIRD_PARTY.md for asset
     attribution, native components and source availability for MPL exceptions.</p>
  <h2>Rust crates</h2>
  {{#each licenses}}
  <section>
    <h3>{{name}}</h3>
    <ul>
      {{#each used_by}}
      <li><a href="https://crates.io/crates/{{crate.name}}/{{crate.version}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
